# Placeholder values only. The backend reads environment variables directly.
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=replace-with-your-selected-model-id

# Optional local Ollama runtime. The backend never downloads models.
# Install/run Ollama yourself, then pull the selected models manually.
LECTOR_OLLAMA_BASE_URL=http://127.0.0.1:11434
LECTOR_EMBEDDING_MODEL=
# Required when LECTOR_EMBEDDING_MODEL is set; e.g. 768 for nomic-embed-text.
LECTOR_EMBEDDING_DIMENSIONS=
# BookNLP runs locally only for books that opted into Graph RAG.
# Default asset directory: <repository-root>/models/booknlp
# Run the documented one-time `python -m lector_rag_api.booknlp_models` setup.
LECTOR_BOOKNLP_ENABLED=true
LECTOR_BOOKNLP_MODEL=small
# Optional absolute directory override. Never points into the venv or SQLite data by default.
LECTOR_BOOKNLP_MODEL_DIR=
LECTOR_GRAPH_BATCH_SIZE=2
LECTOR_GRAPH_BATCH_MAX_ATTEMPTS=2

# Persistent local EPUB originals and answer-audit text logs.
# QA logs can contain copyrighted book excerpts; keep them private.
LECTOR_RAG_DB_PATH=
LECTOR_EPUB_STORAGE_DIR=
LECTOR_QA_LOG_DIR=

# Browser origins allowed to call the local API. Keep this list local and explicit.
LECTOR_CORS_ORIGINS=http://localhost:7127,http://127.0.0.1:7127
